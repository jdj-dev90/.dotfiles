# Template. Copy to ~/.ssh/config (which is gitignored) and add private hosts.
#
#   cp ~/.dotfiles/ssh/.ssh/config.example ~/.ssh/config
#
# ssh takes the FIRST value it obtains for each option, so specific hosts must
# come before the `Host *` block at the bottom.

Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Pattern for an additional identity on the same host -- give it an alias and
# clone with `git@<alias>:org/repo.git`.
#
# Host github.com-<alias>
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/<key>
#   IdentitiesOnly yes

# Pattern for a host reachable only on a private network or VPN.
#
# Host <alias>
#   HostName <address>
#   User <user>
#   IdentityFile ~/.ssh/<key>
#   StrictHostKeyChecking accept-new

# Applies to anything not matched above. Keep last.
Host *
  AddKeysToAgent yes
