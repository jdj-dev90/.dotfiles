{
  "layer": "top",
  "output": ["!SHARE", "*"],
  "position": "top",
  "height": 32,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/rec", "custom/share", "mpris", "custom/dock", "idle_inhibitor", "cpu", "memory", "temperature", "disk", "backlight", "pulseaudio", "bluetooth", "network#traffic", "network", "battery", "custom/nightlight", "tray", "custom/power"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}",
    "persistent-workspaces": {
      "DP-7": [1, 2, 3, 4],
      "DP-6": [5, 6],
      "DP-8": [7, 8, 9, 10]
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "custom/rec": {
    "exec": "$HOME/.local/scripts/screenrec status",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "on-click": "$HOME/.local/scripts/screenrec stop"
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 40,
    "status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "󰓛" },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/nightlight": {
    "exec": "$HOME/.local/scripts/nightlight status",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "on-click": "$HOME/.local/scripts/nightlight toggle"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "$HOME/.local/scripts/menu power"
  },
  "custom/share": {
    "exec": "$HOME/.local/scripts/screenshare status",
    "return-type": "json",
    "interval": 10,
    "signal": 9,
    "on-click": "$HOME/.local/scripts/screenshare toggle",
    "on-click-middle": "$HOME/.local/scripts/screenshare zoom",
    "on-scroll-up": "$HOME/.local/scripts/screenshare prev",
    "on-scroll-down": "$HOME/.local/scripts/screenshare next"
  },
  "custom/dock": {
    "exec": "$HOME/.local/scripts/waybar-dock-status",
    "return-type": "json",
    "interval": 30,
    "signal": 8
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Idle inhibitor on",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "states": { "medium": 40, "warning": 70, "critical": 90 }
  },
  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used\nswap {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "states": { "medium": 50, "warning": 75, "critical": 90 }
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 70,
    "critical-threshold": 85,
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󱃂 {temperatureC}°C"
  },
  "backlight": {
    "device": "intel_backlight",
    "on-scroll-up": "$HOME/.local/scripts/backlight up",
    "on-scroll-down": "$HOME/.local/scripts/backlight down",
    "format": "󰃠 {percent}%"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "$HOME/.local/scripts/waybar-popup bluetooth"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "󰋊 {percentage_used}%",
    "tooltip-format": "{used} / {total} used on {path}",
    "states": { "medium": 60, "warning": 80, "critical": 90 }
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "$HOME/.local/scripts/waybar-popup audio",
    "on-click-right": "pavucontrol",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },
  "network#traffic": {
    "interval": 2,
    "format": "󰁅 {bandwidthDownBytes} 󰁝 {bandwidthUpBytes}",
    "format-disconnected": "",
    "min-length": 22,
    "tooltip-format": "{ifname}  󰁅 {bandwidthDownBits}  󰁝 {bandwidthUpBits}"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪"
  },
  "battery": {
    "states": { "medium": 50, "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6
  }
}
