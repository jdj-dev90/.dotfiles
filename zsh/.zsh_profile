if command -v eza >/dev/null 2>&1; then alias ls='eza'; elif command -v exa >/dev/null 2>&1; then alias ls='exa'; fi
alias cl='clear'
alias v='nvim'
alias t='tmux -u'
alias tmux='tmux -u'
alias mysql="/usr/lib/mysql-workbench/mysql"

# Obsidian
alias oo='cd $SECOND_BRAIN'
alias or='nvim $SECOND_BRAIN/inbox/*.md'

# Secrets (e.g. OBSIDIAN_REST_API_KEY) live in ~/.zsh_secrets, outside the repo.
[ -f "$HOME/.zsh_secrets" ] && . "$HOME/.zsh_secrets"


export DOTFILES=$HOME/.dotfiles
export SCRIPTS=$HOME/.dotfiles/bin/.local/scripts
export STOW_FOLDERS="bin,nvim,tmux,zsh,wayland,ghostty,gitconfig,wallpapers,ssh,worktrunk,cli,mutt,newsboat"
export EDITOR=nvim

export PATH="/home/jordan/.scripts:/home/jordan/.local/bin:/home/jordan/.local/scripts:/home/jordan/.krew/bin:/home/jordan/tools/azure-functions-cli:$PATH"
export FZF_DEFAULT_OPTS='--color=fg:#dcd7ba,bg:#1f1f28,hl:#7e9cd8 --color=fg+:#dcd7ba,bg+:#2d4f67,hl+:#7fb4ca --color=info:#e6c384,prompt:#957fb8,pointer:#ff9e3b --color=marker:#98bb6c,spinner:#e6c384,header:#7aa89f --color=border:#54546d,gutter:#1f1f28'
export SECOND_BRAIN=$HOME/vaults/second-brain

export OPENSSL_DIR=/etc/ssl
export OPENSSL_LIB_DIR=/etc/ssl
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"


# eval $(keychain --eval --agents gpg)
# export OPENAI_API_KEY=$(pass chatgpt/api_key)
