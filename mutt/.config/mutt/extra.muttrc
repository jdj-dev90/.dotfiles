# vim: filetype=neomuttrc
# Additions on top of mutt-wizard. Sourced last from ~/.config/mutt/muttrc.

# %@acct@ labels the account a message lives in (notmuch acct-* tags, set by
# notmuch-tag-accounts). Plain maildir folders have no tags, so it is blank.
index-format-hook acct "~Y acct-personal" "personal "
index-format-hook acct "~Y acct-convert"  "convert  "
index-format-hook acct "~Y acct-hotmail"  "hotmail  "
index-format-hook acct "~Y acct-gumby"    "gumby    "
index-format-hook acct "~A" ""
set index_format = "%4C %Z %{%d %b %H:%M}  %@acct@%-20.20F  %s %> %?X?󰏢 ?%c"
set date_format = "%a %d %b %Y %H:%M"
set sidebar_width = 28
set sidebar_format = "%D%?F? 󰈻%F?%* %?N?%N/?%S"
set sidebar_divider_char = "│"
set status_format = " %f  %?n?󰇮 %n new  ?%?t?󰄬 %t tagged  ?%?d?󰆴 %d deleted  ?%>  %m msgs %P "
set pager_index_lines = 8
set pager_context = 3
set pager_stop = yes
set menu_scroll = yes
set tilde = yes

# Unified views across every account (notmuch index, updated by mailsync).
set nm_default_url = "notmuch:///home/jordan/.local/share/mail"
set nm_query_window_duration = 0
set virtual_spool_file = no

# gu: unread everywhere, gI: every inbox, g/: notmuch search (gi/ga/gs are mutt-wizard's)
macro index,pager gu "<vfolder-from-query>tag:inbox and tag:unread and not folder:/Junk|Spam|Deleted|Trash/<enter>" "unread, all accounts"
macro index,pager gI "<vfolder-from-query>tag:inbox and folder:/INBOX$/<enter>" "inbox, all accounts"
macro index,pager g/ "<vfolder-from-query>" "notmuch search, all accounts"

# More vim motions on top of mutt-wizard's j/k/gg/G/d/u/h/l.
bind index,pager,browser \Cd half-down
bind index,pager,browser \Cu half-up
bind index zz current-middle
bind index zt current-top
bind index zb current-bottom
bind index,pager N search-opposite
bind index \eN toggle-new

# Ctrl-b: pick a link from the message (urlscan) and open it in the browser.
macro index,pager \Cb "<pipe-message> urlscan --compact --dedupe<enter>" "open a link with urlscan"
macro attach,compose \Cb "<pipe-entry> urlscan --compact --dedupe<enter>" "open a link with urlscan"
# V: open the HTML part of the message in the browser.
macro index,pager V "<view-attachments><search>html<enter><view-mailcap><exit>" "open HTML part in browser"
