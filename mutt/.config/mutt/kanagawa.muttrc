# vim: filetype=neomuttrc
# Kanagawa (wave) for NeoMutt, as nearest 256-colour values so it works
# inside tmux (hex needs a terminal that reports truecolor).

color normal      color187 default
color error       color160 default
color warning     color215 default
color message     color110 default
color prompt      color180 default
color status      color180 color236
color indicator   color187 color239
color tree        color103 default
color tilde       color237 default
color markers     color242 default
color search      color235 color180

# Index: dim by default, bright for new, colour for flags.
color index          color180 default "~A"
color index_number   color242 default
color index_date     color110 default
color index_author   color103 default "~A"
color index_subject  color187 default "~A"
color index_size     color242 default
color index_flags    color215 default "~A"
color index          color180 default "~N"
color index_author   color180 default "~N"
color index_subject  color180 default "~N"
color index          color107 default "~F"
color index_author   color107 default "~F"
color index_subject  color107 default "~F"
color index          color168 default "~D"
color index_author   color168 default "~D"
color index_subject  color168 default "~D"
color index          color235 color110 "~T"
color index_author   color235 color110 "~T"
color index_subject  color235 color110 "~T"

# Account labels in unified notmuch views (see extra.muttrc)
color index_tag color110 default "acct-personal"
color index_tag color107 default "acct-convert"
color index_tag color103 default "acct-hotmail"
color index_tag color180 default "acct-gumby"

# Sidebar
color sidebar_divider   color237 default
color sidebar_ordinary  color180 default
color sidebar_highlight color187 color239
color sidebar_indicator color235 color110
color sidebar_new       color180 default
color sidebar_unread    color180 default
color sidebar_flagged   color107 default

# Pager
color hdrdefault  color242 default
color header      color103 default "^From:"
color header      color110 default "^(To|Cc|Bcc):"
color header      color180 default "^Subject:"
color header      color110 default "^Date:"
color quoted      color110 default
color quoted1     color103 default
color quoted2     color107 default
color quoted3     color143 default
color signature   color242 default
color attachment  color215 default
color bold        color187 default
color underline   color110 default
color body        color110 default "(https?|ftp)://[^ \t\n>\"]+"
color body        color103 default "[-a-z_0-9.%$+]+@[-a-z_0-9.]+\\.[a-z]+"
color body        color107 default "^gpg: Good signature.*"
color body        color160 default "^gpg: BAD signature.*"

# Compose
color compose header             color242 default
color compose security_encrypt   color107 default
color compose security_sign      color110 default
color compose security_none      color242 default
