[Unit]
Description=Watch xrandr and reapply X session settings
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/scripts/xrandr-watch
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
