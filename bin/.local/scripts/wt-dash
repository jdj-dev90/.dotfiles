#!/usr/bin/env bash
# wt-dash — live Worktrunk dashboard across repos (for a dedicated tmux pane/monitor)
#
#   wt-dash              # refresh every $WT_DASH_INTERVAL seconds (default 10)
#   WT_DASH_NOTIFY=0     # disable desktop notification when an agent goes 🤖 -> 💬
set -uo pipefail

# ============================
# Config
# ============================
# Repos list: one path per line (# comments ok; relative paths resolve from the
# file's directory). Kept outside dotfiles — paths are machine/client specific.
# Lookup, first match wins:
#   1. wt-dash <file|dir>   (dir -> <dir>/.wt-dash)
#   2. nearest .wt-dash walking up from $PWD   (e.g. one per client dir)
#   3. ~/.config/wt-dash/repos                 (master fallback)
find_repos_file() {
  local arg="${1:-}" d
  if [[ -n "$arg" ]]; then
    [[ -d "$arg" ]] && arg="${arg%/}/.wt-dash"
    printf '%s' "$arg"; return
  fi
  d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/.wt-dash" ]] && { printf '%s' "$d/.wt-dash"; return; }
    d="$(dirname "$d")"
  done
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/wt-dash/repos"
}

REPOS_FILE="$(find_repos_file "${1:-}")"
[[ -f "$REPOS_FILE" ]] || { echo "No repos file: $REPOS_FILE (one repo path per line)" >&2; exit 1; }
REPOS_DIR="$(cd "$(dirname "$REPOS_FILE")" && pwd)"
REPOS=()
while IFS= read -r line; do
  line="${line%%#*}"; line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  line="${line/#\~/$HOME}"
  [[ "$line" != /* ]] && line="${REPOS_DIR}/${line}"
  REPOS+=("$line")
done < "$REPOS_FILE"
(( ${#REPOS[@]} > 0 )) || { echo "No repos listed in $REPOS_FILE" >&2; exit 1; }
INTERVAL="${WT_DASH_INTERVAL:-10}"
NOTIFY="${WT_DASH_NOTIFY:-1}"

# Kanagawa
C_HEAD=$'\033[1;38;2;126;156;216m'   # #7e9cd8
C_RULE=$'\033[38;2;54;54;70m'        # #363646
C_DIM=$'\033[38;2;114;113;105m'      # #727169
C_RST=$'\033[0m'

command -v wt >/dev/null 2>&1 || { echo "wt not found" >&2; exit 1; }

# ============================
# Terminal
# ============================
cleanup() { printf '\033[?25h\033[?1049l'; exit 0; }
trap cleanup INT TERM EXIT
printf '\033[?1049h\033[?25l'   # alt screen, hide cursor

rule() {
  local label="$1" cols="$2" line
  line="── ${label} "
  local pad=$(( cols - ${#line} ))
  (( pad < 0 )) && pad=0
  printf '%s── %s%s%s %s%s\n' "$C_RULE" "$C_HEAD" "$label" "$C_RULE" "$(printf '─%.0s' $(seq 1 "$pad"))" "$C_RST"
}

# ============================
# Notifications (marker transitions)
# ============================
declare -A PREV_MARKER=()

check_markers() {
  local repo="$1" name="$2" branch marker key
  [[ "$NOTIFY" == "1" ]] && command -v notify-send >/dev/null 2>&1 || return 0
  while IFS=$'\t' read -r branch marker; do
    [[ -z "$branch" ]] && continue
    key="${repo}|${branch}"
    if [[ "${PREV_MARKER[$key]:-}" == "🤖" && "$marker" == "💬" ]]; then
      notify-send -a wt-dash "Claude waiting" "${name}: ${branch}" >/dev/null 2>&1 || true
    fi
    PREV_MARKER[$key]="$marker"
  done < <(
    wt -C "$repo" list --format json 2>/dev/null \
      | python3 -c 'import json,sys
for i in json.load(sys.stdin).get("items", []):
    print((i.get("branch") or "") + "\t" + (i.get("marker") or ""))' 2>/dev/null
  )
}

# ============================
# Main loop
# ============================
while true; do
  cols="$(tput cols 2>/dev/null || echo 120)"
  frame=""
  for repo in "${REPOS[@]}"; do
    name="$(basename "$repo")"
    frame+="$(rule "$name" "$cols")"$'\n'
    if [[ -d "$repo" ]]; then
      frame+="$(CLICOLOR_FORCE=1 COLUMNS="$cols" wt -C "$repo" list --full 2>/dev/null)"$'\n\n'
      check_markers "$repo" "$name"
    else
      frame+="  ${C_DIM}(missing: ${repo})${C_RST}"$'\n\n'
    fi
  done
  frame+="${C_DIM}updated $(date +%H:%M:%S) · every ${INTERVAL}s · 🤖 working  💬 waiting · ctrl-c to quit${C_RST}"

  printf '\033[H%s\033[J' "${frame//$'\n'/$'\033[K\n'}"
  sleep "$INTERVAL"
done
