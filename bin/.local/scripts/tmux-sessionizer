#!/usr/bin/env bash
# tmux-sessionizer — zoxide + fzf, riced w/ Kanagawa
set -euo pipefail

# ============================
# Flags
# ============================
DEBUG="${DEBUG:-0}"   # 0=off, 1=debug logs, 2=trace(-x)
DRY_RUN=0
SELECTED_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--debug) DEBUG=1 ;;
    --trace)    DEBUG=2 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --) shift; break ;;
    *)  [[ -z "${SELECTED_ARG:-}" ]] && SELECTED_ARG="$1" || SELECTED_ARG="$1" ;;
  esac
  shift
done

if [[ "$DEBUG" -ge 2 ]]; then
  export PS4='+ ${BASH_SOURCE##*/}:${LINENO}:${FUNCNAME[0]}: '
  set -x
fi

# ============================
# Config
# ============================
ROOTS=(
  "${HOME}/code"
  "${HOME}/.dotfiles"
  "${HOME}/uni"
)
DOTFILES_DIR="${HOME}/.dotfiles"
# TMUX_SESSIONIZER_CLIENT=<client>: switch that tmux client instead of the current one
# (wt-dash on a second monitor opens sessions on the main screen).

MIN_DEPTH="${MIN_DEPTH:-1}"
MAX_DEPTH="${MAX_DEPTH:-4}"

# Kanagawa palette
KAN_BG="#1f1f28"
KAN_BG_PLUS="#2a2a37"
KAN_FG="#dcd7ba"
KAN_HL="#7e9cd8"
KAN_HL_WARN="#dca561"
KAN_ACCENT="#938aa9"
KAN_INFO="#6a9589"
KAN_PROMPT="#957fb8"
KAN_POINTER="#c34043"
KAN_MARKER="#98bb6c"
KAN_SPINNER="#7aa89f"
KAN_BORDER="#363646"

# ============================
# Wayland env helpers
# ============================
ensure_wayland_env() {
  local uid runtime_dir socket
  uid="$(id -u)"
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    if [[ -S "${runtime_dir}/wayland-1" ]]; then
      export WAYLAND_DISPLAY="wayland-1"
    elif [[ -S "${runtime_dir}/wayland-0" ]]; then
      export WAYLAND_DISPLAY="wayland-0"
    fi
  fi
  export XDG_RUNTIME_DIR="${runtime_dir}"
}

# ============================
# Helpers
# ============================
ts() { date +"%H:%M:%S"; }
ce() { printf '\033[%sm' "$1" ; }
log() { [[ "$DEBUG" -ge 1 ]] || return 0; printf "%s[DEBUG %s]%s %s\n" "$(ce '1;36')" "$(ts)" "$(ce '0')" "$*" >&2; }
warn(){ printf "%s[WARN ]%s %s\n" "$(ce '1;33')" "$(ce '0')" "$*" >&2; }
die() { printf "%s[ERROR]%s %s\n" "$(ce '1;31')" "$(ce '0')" "$*" >&2; exit 1; }

abs() { cd "$1" 2>/dev/null && pwd -P || true; }
unique() { awk '!seen[$0]++'; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }

tmux_server_running() {
  tmux ls >/dev/null 2>&1
}

in_roots() {
  local p="$1"
  for r in "${ABS_ROOTS[@]}"; do
    [[ "$p" == "$r"* ]] && return 0
  done
  return 1
}

IGNORE_DIRS=(node_modules .git dist build .cache .next .turbo target .venv .tox .mypy_cache .pytest_cache .gradle .idea .vscode)

should_ignore() {
  local p="$1"
  for ig in "${IGNORE_DIRS[@]}"; do
    [[ "$p" == *"/$ig"* ]] && return 0
  done
  return 1
}

is_project_root() {
  local d="$1"
  [[ -e "$d/.git" ]] && return 0  # -e: worktrees have a .git file
  [[ -f "$d/.wt-dash" ]] && return 0  # client dir with a wt-dash repo list
  [[ -f "$d/package.json" ]] && return 0
  [[ -f "$d/pyproject.toml" ]] && return 0
  [[ -f "$d/Pipfile" ]] && return 0
  [[ -f "$d/go.mod" ]] && return 0
  [[ -f "$d/Cargo.toml" ]] && return 0
  [[ -f "$d/composer.json" ]] && return 0
  [[ -f "$d/pom.xml" || -f "$d/build.gradle" || -f "$d/settings.gradle" ]] && return 0
  [[ -f "$d/.terraform.lock.hcl" || -d "$d/.terraform" ]] && return 0
  return 1
}

# ============================
# Resolve roots
# ============================
declare -a ABS_ROOTS=()
DOTFILES_ABS=""
for r in "${ROOTS[@]}"; do
  ar="$(abs "$r")"
  if [[ -d "$ar" ]]; then
    ABS_ROOTS+=("$ar")
    [[ "$ar" == "$(abs "$DOTFILES_DIR")" ]] && DOTFILES_ABS="$ar"
  else
    log "Skip root (not found): $r"
  fi
done
[[ "${#ABS_ROOTS[@]}" -gt 0 ]] || die "No valid roots. Checked: ${ROOTS[*]}"

# ============================
# Candidate builder (zoxide + find)
# ============================
build_candidates() {
  local -a zlist=() flist=()

  # zoxide
  if command -v zoxide >/dev/null 2>&1; then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local p="${line#* }"
      [[ -z "$p" ]] && continue
      if [[ -n "$DOTFILES_ABS" && "$p" == "$DOTFILES_ABS"* ]]; then
        zlist+=("$p"); continue
      fi
      in_roots "$p" || continue
      should_ignore "$p" && continue
      is_project_root "$p" || continue
      zlist+=("$p")
    done < <(zoxide query -ls 2>/dev/null || true)
  fi

  # find
  require_cmd find
  for root in "${ABS_ROOTS[@]}"; do
    if [[ -n "$DOTFILES_ABS" && "$root" == "$DOTFILES_ABS" ]]; then
      while IFS= read -r d; do flist+=("$d"); done < <(find "$root" -type d -print 2>/dev/null)
    else
      while IFS= read -r d; do
        should_ignore "$d" && continue
        is_project_root "$d" || continue
        flist+=("$d")
      done < <(
        find "$root" \
          -type d \( $(printf -- '-name %q -o ' "${IGNORE_DIRS[@]}") -false \) -prune -o \
          -mindepth "$MIN_DEPTH" -maxdepth "$MAX_DEPTH" -type d -print 2>/dev/null
      )
    fi
  done

  { printf '%s\n' "${zlist[@]}"; printf '%s\n' "${flist[@]}"; } | unique
}

# ============================
# FZF (Kanagawa rice)
# ============================
fzf_pick() {
  require_cmd fzf
  local list="$1"
  [[ -n "$list" ]] || { warn "No candidates"; printf ''; return; }

  local LS="ls -lah --group-directories-first --color=always"
  command -v exa >/dev/null 2>&1 && LS="exa -la --group-directories-first --icons --git"

  local PREVIEW='
    P={1};
    test -d "$P" || exit 0;
    echo -e "\033[1m$P\033[0m";
    (cd "$P" && '"$LS"' | sed -n "1,80p");
    echo;
    test -e "$P/.git" && (cd "$P" && echo "[git status]" && git -c color.ui=always status -sb || true)
  '

  printf '%s\n' "$list" | fzf \
    --prompt="  " \
    --pointer="" \
    --marker="" \
    --height=40% --layout=reverse --border=rounded --ansi --tabstop=2 \
    --color="fg:${KAN_FG},bg:${KAN_BG},hl:${KAN_HL}" \
    --color="fg+:${KAN_FG},bg+:${KAN_BG_PLUS},hl+:${KAN_HL}" \
    --color="info:${KAN_INFO},prompt:${KAN_PROMPT},pointer:${KAN_POINTER},marker:${KAN_MARKER},spinner:${KAN_SPINNER},border:${KAN_BORDER}" \
    --preview="$PREVIEW" --preview-window=down,45%,border-rounded \
  || true
}

# ============================
# Picker
# ============================
pick_dir() {
  if [[ -n "${SELECTED_ARG:-}" ]]; then
    printf '%s\n' "$SELECTED_ARG"
    return
  fi
  local list
  list="$(build_candidates)"
  fzf_pick "$list"
}

# ============================
# tmux window helpers
# ============================
ensure_window() {
  local sid="$1" win_name="$2" win_index="$3" cwd="$4"
  local existing

  existing="$(tmux list-windows -t "$sid" -F '#{window_name}' | awk -v n="$win_name" '$0 == n {print n; exit}')"
  if [[ -n "$existing" ]]; then
    tmux move-window -t "$sid:$win_index" -s "$sid:$win_name" >/dev/null 2>&1 || true
    printf 'existing'
  else
    tmux new-window -d -t "$sid:$win_index" -n "$win_name" -c "$cwd"
    printf 'created'
  fi
}

pane_command() {
  local target="$1"
  tmux display-message -p -t "$target" '#{pane_current_command}' 2>/dev/null || true
}

window_pane_count() {
  local sid="$1" target="$2"
  tmux list-panes -t "$sid:$target" -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ' | sed 's/[^0-9]//g'
}

pane_ids_by_left() {
  local sid="$1" target="$2"
  tmux list-panes -t "$sid:$target" -F '#{pane_id} #{pane_left}' 2>/dev/null \
    | sort -k2 -n | awk '{print $1}'
}

leftmost_pane_id() {
  local sid="$1" target="$2"
  tmux list-panes -t "$sid:$target" -F '#{pane_id} #{pane_left}' 2>/dev/null \
    | sort -k2 -n | awk 'NR==1 {print $1; exit}'
}

ensure_three_panes() {
  local sid="$1" target="$2" cwd="$3"
  local count left_pane

  count="$(window_pane_count "$sid" "$target")"
  if [[ "$count" -eq 1 ]]; then
    left_pane="$(leftmost_pane_id "$sid" "$target")"
    [[ -n "$left_pane" ]] || return 0
    tmux split-window -h -p 20 -t "$left_pane" -c "$cwd"
    left_pane="$(leftmost_pane_id "$sid" "$target")"
    tmux split-window -h -p 75 -t "$left_pane" -c "$cwd"
  elif [[ "$count" -eq 2 ]]; then
    left_pane="$(leftmost_pane_id "$sid" "$target")"
    [[ -n "$left_pane" ]] || return 0
    tmux split-window -h -p 75 -t "$left_pane" -c "$cwd"
  fi
}

detect_layout_mode() {
  if [[ -n "${TMUX_SESSIONIZER_LAYOUT:-}" ]]; then
    printf '%s' "$TMUX_SESSIONIZER_LAYOUT"
    return 0
  fi

  if [[ -d /sys/class/drm ]]; then
    for status_file in /sys/class/drm/*/status; do
      [[ -e "$status_file" ]] || continue
      output_name="${status_file%/status}"
      output_name="${output_name##*/}"
      case "$output_name" in
        *eDP*|*LVDS*) continue ;;
      esac
      if [[ "$(cat "$status_file" 2>/dev/null)" == "connected" ]]; then
        printf '%s' "panes"
        return 0
      fi
    done
  fi

  if command -v hyprctl >/dev/null 2>&1; then
    hypr_output="$(hyprctl monitors 2>/dev/null || true)"
    if [[ -n "$hypr_output" ]]; then
      if printf '%s\n' "$hypr_output" | grep -q '^Monitor DP-6 '; then
        printf '%s' "panes"
        return 0
      fi
      if printf '%s\n' "$hypr_output" | grep -q '^Monitor DP-7 '; then
        printf '%s' "panes"
        return 0
      fi
    fi
  fi

  printf '%s' "windows"
}

is_shell_cmd() {
  case "$1" in
    bash|zsh|fish|sh|dash) return 0 ;;
    *) return 1 ;;
  esac
}

# Claude stores sessions under ~/.claude/projects/<path with non-alnum -> '-'>
agent_cmd_for_project() {
  local dir="$1" key
  key="$(printf '%s' "$dir" | sed 's/[^A-Za-z0-9]/-/g')"
  if compgen -G "${HOME}/.claude/projects/${key}/*.jsonl" >/dev/null; then
    printf 'claude --continue'
  else
    printf 'claude'
  fi
}

ensure_session_panes() {
  local selected="$1" selected_name="$2"

  require_cmd tmux
  if ! tmux has-session -t "$selected_name" 2>/dev/null; then
    tmux -u new-session -ds "$selected_name" -c "$selected" -n work
  fi

  ensure_window "$selected_name" work 1 "$selected" >/dev/null
  ensure_three_panes "$selected_name" work "$selected"

  mapfile -t pane_ids < <(pane_ids_by_left "$selected_name" work)
  left_pane="${pane_ids[0]:-}"
  mid_pane="${pane_ids[1]:-}"
  right_pane="${pane_ids[2]:-}"

  if [[ -n "$mid_pane" ]]; then
    cmd="$(pane_command "$mid_pane")"
    if is_shell_cmd "$cmd"; then
      tmux send-keys -t "$mid_pane" "nvim" C-m
    fi
  fi

  if [[ -n "$right_pane" ]]; then
    cmd="$(pane_command "$right_pane")"
    if is_shell_cmd "$cmd"; then
      tmux send-keys -t "$right_pane" "$(agent_cmd_for_project "$selected")" C-m
    fi
  fi

  if [[ -n "$left_pane" ]]; then
    tmux send-keys -t "$left_pane" C-c
  fi

  tmux select-window -t "$selected_name:work" >/dev/null 2>&1 || true
  tmux select-pane -t "$mid_pane" >/dev/null 2>&1 || true
  tmux display-message "Loaded project: ${selected_name}"
}

ensure_session_windows() {
  local selected="$1" selected_name="$2"

  require_cmd tmux
  if ! tmux has-session -t "$selected_name" 2>/dev/null; then
    tmux -u new-session -ds "$selected_name" -c "$selected" -n editor
  fi

  editor_state="$(ensure_window "$selected_name" editor 1 "$selected")"
  if [[ "$editor_state" == "created" ]]; then
    tmux send-keys -t "$selected_name:editor.1" "nvim" C-m
  else
    if [[ "$(window_pane_count "$selected_name" editor)" -eq 1 ]]; then
      cmd="$(pane_command "$selected_name:editor.1")"
      if is_shell_cmd "$cmd"; then
        tmux send-keys -t "$selected_name:editor.1" "nvim" C-m
      fi
    fi
  fi

  agent_state="$(ensure_window "$selected_name" agent 2 "$selected")"
  if [[ "$agent_state" == "created" ]]; then
    tmux send-keys -t "$selected_name:agent.1" "$(agent_cmd_for_project "$selected")" C-m
  else
    if [[ "$(window_pane_count "$selected_name" agent)" -eq 1 ]]; then
      cmd="$(pane_command "$selected_name:agent.1")"
      if is_shell_cmd "$cmd"; then
        tmux send-keys -t "$selected_name:agent.1" "$(agent_cmd_for_project "$selected")" C-m
      fi
    fi
  fi

  ensure_window "$selected_name" term 3 "$selected" >/dev/null

  tmux select-window -t "$selected_name:editor" >/dev/null 2>&1 || true
  tmux display-message "Loaded project: ${selected_name}"
}

# ============================
# Pane lookup (avoid duplicate tabs)
# ============================
find_target_for_path() {
  local target_path
  target_path="$(abs "$1")"

  # If no server, nothing to find — return empty safely (avoid set -e exit)
  if ! tmux_server_running; then
    echo ""
    return 0
  fi

  # "<session>:<win>.<pane> <pane_current_path>"
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_current_path}' 2>/dev/null \
    | awk -v p="$target_path" '$0 ~ (" " p "$") { print $1; exit }' || true
}

# ============================
# Main
# ============================
selected="$(pick_dir)"
[[ -z "${selected:-}" ]] && exit 0
selected="$(abs "$selected")"

selected_name="_$(basename "$selected" | tr . _)"
log "Selected: $selected"
log "Session : $selected_name"

ensure_wayland_env

if [[ "$DRY_RUN" -eq 1 ]]; then
  log "[DRY-RUN] Would search panes and build tmux layout for '$selected_name' @ '$selected'"
  exit 0
fi

# Client dir with a .wt-dash list -> a single dashboard session running wt-dash.
# Matched by session name, not pane path, so other panes in this dir don't hijack it.
if [[ -f "$selected/.wt-dash" ]]; then
  require_cmd tmux
  dash_name="${selected_name}_dash"
  if ! tmux has-session -t "=$dash_name" 2>/dev/null; then
    # run as the pane command (no send-keys race); drop to a shell if it exits
    tmux -u new-session -ds "$dash_name" -c "$selected" -n dash "wt-dash; exec \"\${SHELL:-bash}\""
  fi
  if [[ -z "${TMUX:-}" ]]; then
    exec tmux -u attach -t "=$dash_name"
  else
    tmux switch-client ${TMUX_SESSIONIZER_CLIENT:+-c "$TMUX_SESSIONIZER_CLIENT"} -t "=$dash_name"
  fi
  exit 0
fi

# If a pane anywhere is already in this dir, jump there.
existing_target="$(find_target_for_path "$selected")"
if [[ -n "$existing_target" ]]; then
  existing_session="${existing_target%%:*}"
  existing_window="${existing_target%.*}"
  if [[ -z "${TMUX:-}" ]]; then
    exec tmux -u attach -t "$existing_session" \; select-window -t "$existing_window" \; select-pane -t "$existing_target"
  else
    tmux switch-client ${TMUX_SESSIONIZER_CLIENT:+-c "$TMUX_SESSIONIZER_CLIENT"} -t "$existing_session"
    tmux select-window -t "$existing_window"
    tmux select-pane -t "$existing_target"
  fi
  exit 0
fi

# Otherwise create (or reuse) the per-project session + layout
layout_mode="$(detect_layout_mode)"
case "$layout_mode" in
  windows) ensure_session_windows "$selected" "$selected_name" ;;
  *) ensure_session_panes "$selected" "$selected_name" ;;
esac

if [[ -z "${TMUX:-}" ]]; then
  exec tmux -u attach -t "$selected_name"
else
  tmux switch-client ${TMUX_SESSIONIZER_CLIENT:+-c "$TMUX_SESSIONIZER_CLIENT"} -t "$selected_name"
fi
