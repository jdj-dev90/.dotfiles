#!/bin/sh
# Open a floating TUI popup from a waybar module (styled by a Hyprland
# windowrule on the dev.waybar.* class). Each popup prefers the nicer TUI and
# falls back to what ships with the base tools.
set -eu

pick() {
  for c in "$@"; do
    if command -v "$c" >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return
    fi
  done
}

case "${1:-}" in
  bluetooth) title=Bluetooth; cmd="$(pick bluetui bluetoothctl)" ;;
  audio)     title=Audio;     cmd="$(pick wiremix ncpamixer pulsemixer)" ;;
  updates)   title=Updates;   cmd="$(pick yay pacman)" ;;
  mail)      title=Mail;      cmd="$(pick neomutt)" ;;
  *)
    echo "usage: waybar-popup bluetooth|audio|updates|mail" >&2
    exit 2
    ;;
esac

[ -n "${cmd}" ] || exit 1

# ncpamixer defaults to the Playback tab, which is empty when nothing plays.
[ "${cmd}" = ncpamixer ] && cmd="ncpamixer --tab=output"

# Toggle: clicking the module again closes an open popup.
class="dev.waybar.$1"
addr="$(hyprctl clients -j | jq -r --arg c "${class}" '.[] | select(.class == $c) | .address' | head -n 1)"
if [ -n "${addr}" ]; then
  hyprctl dispatch closewindow "address:${addr}" >/dev/null
  exit 0
fi

# Updates: keep the window open afterwards so the result can be read, then
# refresh the waybar count.
if [ "$1" = updates ]; then
  exec ghostty --class="${class}" --title="${title}" -e sh -c \
    "${cmd} -Syu; pkill -RTMIN+12 -x waybar; printf '\\nDone. Press Enter to close.'; read -r _"
fi

# cmd is word-split on purpose: it may carry flags (e.g. ncpamixer --tab=output).
# Mail: refresh the unread count once neomutt closes.
if [ "$1" = mail ]; then
  exec ghostty --class="${class}" --title="${title}" -e sh -c "${cmd}; pkill -RTMIN+15 -x waybar"
fi

# shellcheck disable=SC2086
exec ghostty --class="${class}" --title="${title}" -e ${cmd}
