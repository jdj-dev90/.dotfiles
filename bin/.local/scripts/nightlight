#!/bin/sh
# Night light via hyprsunset. Its schedule lives in hypr/hyprsunset.conf;
# toggle overrides it until the next scheduled change.
#   nightlight toggle|on|off|status
set -eu

warm=4000
# Must match the profile times in hypr/hyprsunset.conf.
warm_from=2000 # 20:00
cool_from=0700 # 07:00

override="${XDG_RUNTIME_DIR:-/tmp}/nightlight.override" # "on"/"off"
refresh() { pkill -RTMIN+11 -x waybar 2>/dev/null || true; }

scheduled() {
  now="$(date +%H%M)"
  if [ "${now}" -ge "${warm_from}" ] || [ "${now}" -lt "${cool_from}" ]; then echo on; else echo off; fi
}

# Epoch of the most recent scheduled change, so a stale override is ignored.
last_change() {
  now="$(date +%H%M)"
  if [ "${now}" -ge "${warm_from}" ]; then date -d "today ${warm_from%??}:${warm_from#??}" +%s
  elif [ "${now}" -ge "${cool_from}" ]; then date -d "today ${cool_from%??}:${cool_from#??}" +%s
  else date -d "yesterday ${warm_from%??}:${warm_from#??}" +%s
  fi
}

current() {
  if [ -f "${override}" ] && [ "$(stat -c %Y "${override}")" -ge "$(last_change)" ]; then
    cat "${override}"
  else
    scheduled
  fi
}

set_state() {
  if [ "$1" = on ]; then
    hyprctl hyprsunset temperature "${warm}" >/dev/null
  else
    hyprctl hyprsunset identity >/dev/null
  fi
  echo "$1" > "${override}"
  refresh
}

case "${1:-status}" in
  on | off) set_state "$1" ;;
  toggle) if [ "$(current)" = on ]; then set_state off; else set_state on; fi ;;
  status)
    if [ "$(current)" = on ]; then
      printf '{"text":"󰖔","class":"on","tooltip":"Night light on (%sK)\\nscheduled 20:00-07:00, click to override"}\n' "${warm}"
    else
      printf '{"text":"󰖙","class":"off","tooltip":"Night light off\\nscheduled 20:00-07:00, click to override"}\n'
    fi
    ;;
  *) echo "usage: nightlight toggle|on|off|status" >&2; exit 2 ;;
esac
