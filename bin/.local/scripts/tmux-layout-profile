#!/usr/bin/env bash
# tmux-layout-profile — reshape live tmux sessions between the two layouts
# tmux-sessionizer builds:
#
#   panes   (docked)  one "work" window, three side-by-side panes:
#                     term | nvim | agent
#   windows (laptop)  three windows: 1 editor, 2 agent, 3 term
#
# Existing sessions keep whatever shape they were created with, so after
# docking or undocking run this to re-flow them. Panes are moved, never
# killed, so running processes (nvim, the agent) survive.
#
# Usage: tmux-layout-profile [panes|windows|auto] [-s SESSION] [-n]
#   auto (default) picks the mode the same way tmux-sessionizer does:
#   any connected non-internal display means docked.
set -euo pipefail

MODE=auto
ONLY_SESSION=""
DRY_RUN=0

# Sessionizer's window/pane roles, left to right in panes mode.
LEFT_NAME=term
MID_NAME=editor
RIGHT_NAME=agent
COMBINED_NAME=work

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; /^set -euo/d'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    panes|windows|auto) MODE="$1" ;;
    -s|--session) ONLY_SESSION="${2:?-s needs a session name}"; shift ;;
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help) usage 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage 1 ;;
  esac
  shift
done

command -v tmux >/dev/null 2>&1 || { echo "tmux not found" >&2; exit 1; }
tmux list-sessions >/dev/null 2>&1 || { echo "no tmux server running" >&2; exit 0; }

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  would: tmux %s\n' "$*"
  else
    tmux "$@" >/dev/null 2>&1 || true
  fi
}

# Same docked test as hypr-monitor-profile / tmux-sessionizer: an external
# display is connected, so there is room for three panes side by side.
detect_mode() {
  local status_file output_name
  if [[ -d /sys/class/drm ]]; then
    for status_file in /sys/class/drm/*/status; do
      [[ -e "$status_file" ]] || continue
      output_name="${status_file%/status}"
      output_name="${output_name##*/}"
      case "$output_name" in *eDP*|*LVDS*) continue ;; esac
      if [[ "$(cat "$status_file" 2>/dev/null)" == "connected" ]]; then
        printf 'panes'
        return
      fi
    done
  fi
  printf 'windows'
}

session_ids() {
  if [[ -n "$ONLY_SESSION" ]]; then
    # Session names can carry a Nerd Font glyph, so match on a substring of
    # the name rather than trusting an exact -t target.
    tmux list-sessions -F '#{session_id} #{session_name}' \
      | awk -v n="$ONLY_SESSION" 'index($2, n) {print $1}'
  else
    tmux list-sessions -F '#{session_id}'
  fi
}

session_name_of() { tmux display -p -t "$1" '#{session_name}'; }

# window id of the first window with at least $2 panes
multi_pane_window() {
  tmux list-windows -t "$1" -F '#{window_id} #{window_panes}' \
    | awk -v min="$2" '$2 >= min {print $1; exit}'
}

window_by_name() {
  tmux list-windows -t "$1" -F '#{window_id} #{window_name}' \
    | awk -v n="$2" '$2 == n {print $1; exit}'
}

panes_left_to_right() {
  tmux list-panes -t "$1" -F '#{pane_id} #{pane_left}' | sort -k2 -n | awk '{print $1}'
}

# Put the named windows at indices base-index, +1, +2 in the given order.
order_windows() {
  local sid="$1"; shift
  local base idx wid cur name
  base="$(tmux show -gv base-index 2>/dev/null || echo 0)"
  idx="$base"
  for name in "$@"; do
    wid="$(window_by_name "$sid" "$name")"
    if [[ -n "$wid" ]]; then
      cur="$(tmux display -p -t "$wid" '#{window_index}')"
      if [[ "$cur" != "$idx" ]]; then
        if [[ "$DRY_RUN" -eq 1 ]]; then
          printf '  would: move window %s (%s) to index %s\n' "$name" "$wid" "$idx"
        else
          tmux swap-window -d -s "$wid" -t "$sid:$idx" >/dev/null 2>&1 \
            || tmux move-window -d -s "$wid" -t "$sid:$idx" >/dev/null 2>&1 \
            || true
        fi
      fi
    fi
    idx=$((idx + 1))
  done
}

# panes -> windows: break the three panes out into their own windows.
to_windows() {
  local sid="$1" wid left mid right
  wid="$(multi_pane_window "$sid" 3)"
  [[ -n "$wid" ]] || return 1

  read -r left mid right _ < <(panes_left_to_right "$wid" | tr '\n' ' ')
  [[ -n "$left" && -n "$mid" && -n "$right" ]] || return 1

  # -a -t "$wid" keeps the new window in the source pane's own session;
  # without it break-pane drops the window into the attached session.
  run break-pane -d -a -t "$wid" -s "$mid" -n "$MID_NAME"
  run break-pane -d -a -t "$wid" -s "$right" -n "$RIGHT_NAME"
  run rename-window -t "$left" "$LEFT_NAME"
  order_windows "$sid" "$MID_NAME" "$RIGHT_NAME" "$LEFT_NAME"
  return 0
}

# windows -> panes: join the three windows back into one side-by-side window.
to_panes() {
  local sid="$1" left_w mid_w right_w left mid right

  # Already combined?
  [[ -z "$(multi_pane_window "$sid" 3)" ]] || return 1

  left_w="$(window_by_name "$sid" "$LEFT_NAME")"
  mid_w="$(window_by_name "$sid" "$MID_NAME")"
  right_w="$(window_by_name "$sid" "$RIGHT_NAME")"
  [[ -n "$left_w" && -n "$mid_w" && -n "$right_w" ]] || return 1

  left="$(panes_left_to_right "$left_w" | head -1)"
  mid="$(panes_left_to_right "$mid_w" | head -1)"
  right="$(panes_left_to_right "$right_w" | head -1)"

  run join-pane -h -d -s "$mid" -t "$left"
  run join-pane -h -d -s "$right" -t "$mid"
  run rename-window -t "$left" "$COMBINED_NAME"
  run select-layout -t "$left" even-horizontal
  return 0
}

[[ "$MODE" == auto ]] && MODE="$(detect_mode)"

changed=0 skipped=0
while read -r sid; do
  [[ -n "$sid" ]] || continue
  name="$(session_name_of "$sid")"
  if [[ "$MODE" == windows ]]; then
    if to_windows "$sid"; then
      printf 'reshaped %s -> windows\n' "$name"; changed=$((changed + 1))
    else
      skipped=$((skipped + 1))
    fi
  else
    if to_panes "$sid"; then
      printf 'reshaped %s -> panes\n' "$name"; changed=$((changed + 1))
    else
      skipped=$((skipped + 1))
    fi
  fi
done < <(session_ids)

printf '%s layout: %d reshaped, %d already fine or not a project session\n' \
  "$MODE" "$changed" "$skipped"
