#!/bin/sh
# Pick the default audio output from what's plugged in, best first:
# Corsair headset (100% volume), ThinkPad dock audio, laptop speaker.
# Run at login (audio-defaults.service) and on dock/undock (hypr-monitor-profile).
# USB audio shows up a few seconds after docking, so retry briefly.
set -u

headset="alsa_output.usb-Corsair_CORSAIR_HS70_Pro_Wireless_Gaming_Headset-00.analog-stereo"
dock="alsa_output.usb-Lenovo_ThinkPad_Thunderbolt_4_Dock_USB_Audio_000000000000-00.analog-stereo"
speaker="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink"

docked() {
  for f in /sys/class/drm/*/status; do
    case "${f}" in *eDP* | *LVDS*) continue ;; esac
    [ "$(cat "${f}" 2>/dev/null)" = connected ] && return 0
  done
  return 1
}

has() { pactl list short sinks | awk '{print $2}' | grep -qx "$1"; }

# Docked: wait up to 10s for USB audio to appear before settling on the speaker.
tries=1
docked && tries=20
while [ "${tries}" -gt 0 ]; do
  if has "${headset}"; then
    pactl set-default-sink "${headset}" && pactl set-sink-volume "${headset}" 100%
    exit 0
  fi
  if has "${dock}"; then
    pactl set-default-sink "${dock}"
    exit 0
  fi
  tries=$((tries - 1))
  [ "${tries}" -gt 0 ] && sleep 0.5
done
pactl set-default-sink "${speaker}"
