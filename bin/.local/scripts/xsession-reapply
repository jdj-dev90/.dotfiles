#!/bin/sh
set -eu

DISPLAY=${DISPLAY:-:0}
XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority}
export DISPLAY XAUTHORITY

if command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap -layout au -option caps:escape
fi

if command -v xset >/dev/null 2>&1; then
  xset r rate 200 35
fi

layout_script="$HOME/.screenlayout/home_layout.sh"
if [ -x "$layout_script" ]; then
  "$layout_script"
fi

if command -v feh >/dev/null 2>&1 && [ -d "$HOME/.wallpapers" ]; then
  rwp=$(find "$HOME/.wallpapers/" -type f 2>/dev/null | shuf -n 1)
  if [ -n "${rwp:-}" ]; then
    feh --bg-scale "$rwp"
  fi
fi
